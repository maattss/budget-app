# Production environment template.
#
# Copy the values you need into your host's environment settings (Laravel Cloud,
# Forge, Fly, ...). Do not commit a filled-in copy of this file.

APP_NAME=Saldo
APP_ENV=production
APP_DEBUG=false

# Generate once, then keep it. Changing it invalidates every session, every
# encrypted column and every signed URL:
#   php artisan key:generate --show
APP_KEY=

# Must be the real HTTPS origin. Livewire builds its update endpoint from this, and
# WebAuthn derives the passkey relying-party ID from the host - a mismatch here means
# passkeys silently fail to verify.
APP_URL=https://your-domain.example

# MySQL, deliberately - matching development. The test suite already runs on SQLite,
# and adding Postgres as a third engine multiplies the "passes in CI, fails in
# production" surface (collation case-sensitivity and DECIMAL scale both differ).
# DB_CONNECTION must be set explicitly. Laravel Cloud injects DB_HOST, DB_USERNAME,
# DB_PASSWORD and DB_DATABASE when you attach a database, but NOT DB_CONNECTION - and
# without it the app previously fell back to sqlite and went looking for a file that does
# not exist in the container.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Required if the managed MySQL instance enforces SSL.
MYSQL_ATTR_SSL_CA="/etc/ssl/certs/ca-certificates.crt"

# This app has no queued jobs and no scheduled tasks, so the database driver needs no
# worker process. Revisit if that changes.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# LEAVE UNSET. Registration defaults to off (config/fortify.php) because this is a
# single-user app - setting this to true opens public sign-up.
# FORTIFY_REGISTRATION=false

# A real mailer is not optional in production: password reset and email verification
# both go through it, and with the log driver a lockout is unrecoverable.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="saldo@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Nightwatch. Laravel Cloud's native integration injects the token for you; set these
# only if you are wiring it up manually.
NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=
